 
API_KEY=your-openai-api-key
SARVAM_API_KEY=your-sarvam-api-key

# Optional - Model
MODEL_NAME=gpt-4.1
BASE_URL=https://api.openai.com/v1

# Optional - LiteLLM provider credentials.
# OpenAI-compatible providers use API_KEY/BASE_URL above. Other providers
# read their own standard LiteLLM environment variables:
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
# Local Ollama server (either name works; OLLAMA_API_BASE wins if both set)
OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Optional - Vision model for PDF OCR. Accepts a logical name from
# agents.yaml (e.g. "vision") or a raw LiteLLM model string.
# Defaults to the runtime model when unset.
VISION_MODEL_NAME=vision

# Optional - Model routing (ModelRouter -> logical model fast/clinical/retrieval)
LLM_ROUTING_ENABLED=false
# Comma-separated fallback models (logical or LiteLLM names) tried in order
# when the primary model fails. These logical names are defined in agents.yaml.
LLM_FALLBACK_MODELS=gemini,ollama
LLM_TIMEOUT=60
LLM_NUM_RETRIES=3

# Optional - STT (Speech to Text)
STT_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3
STT_LANGUAGE=en

# Optional - TTS (Text to Speech)
TTS_PROVIDER=sarvam
SARVAM_TTS_MODEL=bulbul:v3
TTS_LANGUAGE=en-IN
SARVAM_SPEAKER=neha

# Optional - MLflow tracking
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=clinical-voice

# Optional - VAD (Voice Activity Detection)
VAD_ENABLED=true

# Optional - FHIR
FHIR_BASE_URL="https//example.com"

# # IAM
IAM_JWKS_URL=https//example.com

IAM_ISSUER=https://example.com